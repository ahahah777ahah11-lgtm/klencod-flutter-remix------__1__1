{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FirestoreSchema",
  "description": "Firestore database schema for Smart Debt Manager cloud backups",
  "type": "object",
  "properties": {
    "users": {
      "type": "object",
      "description": "User accounts and their isolated cloud data",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "email": { "type": "string" },
          "displayName": { "type": "string" },
          "updatedAt": { "type": "integer" }
        },
        "required": ["email", "updatedAt"]
      }
    },
    "backups": {
      "type": "object",
      "description": "User cloud debt manager backups",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "userId": { "type": "string" },
          "storeName": { "type": "string" },
          "customerCount": { "type": "integer" },
          "transactionCount": { "type": "integer" },
          "dataJson": { "type": "string" },
          "timestamp": { "type": "integer" }
        },
        "required": ["userId", "timestamp", "dataJson"]
      }
    }
  }
}
